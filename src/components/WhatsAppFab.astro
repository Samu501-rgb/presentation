---
/**
 * Pulsante WhatsApp flottante: compare dopo l'hero, si nasconde vicino al footer
 * e, su mobile, mentre scorri verso il basso (così non copre i contenuti).
 */
import { Icon } from 'astro-icon/components';
import { linkWhatsApp } from '../data/negozio';
---

<aside aria-label="Contatto rapido">
  <a
    href={linkWhatsApp()}
    class="fab tocco fixed bottom-4 right-4 z-40 grid size-14 place-items-center rounded-full bg-pomodoro-700 text-carta shadow-[0_10px_30px_-10px_rgb(31_26_23/0.6)] md:bottom-6 md:right-6 md:size-16"
    aria-label="Scrivici su WhatsApp"
    target="_blank"
    rel="noopener"
    data-fab
  >
    <Icon name="lucide:message-circle" class="icona size-7" aria-hidden="true" />
  </a>
</aside>

<style>
  .fab {
    transition:
      transform 0.5s var(--ease-casa),
      opacity 0.3s;
  }
  .fab--nascosto {
    transform: translateY(140%) scale(0.6);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>('[data-fab]');
  if (fab) {
    const hero = document.querySelector('[data-hero]');
    const footer = document.querySelector('footer');
    let dopoHero = !hero;
    let vicinoFooter = false;
    let giù = false;
    let ultimo = window.scrollY;
    const mobile = matchMedia('(max-width: 767px)');
    const aggiorna = () => {
      const nascondi = !dopoHero || vicinoFooter || (mobile.matches && giù);
      fab.classList.toggle('fab--nascosto', nascondi);
      // Quando è nascosto non deve ricevere il focus da tastiera.
      if (nascondi) fab.setAttribute('tabindex', '-1');
      else fab.removeAttribute('tabindex');
    };
    if (hero) {
      new IntersectionObserver(([e]) => {
        dopoHero = !e.isIntersecting && e.boundingClientRect.top < 0;
        aggiorna();
      }).observe(hero);
    }
    if (footer) {
      new IntersectionObserver(
        ([e]) => {
          vicinoFooter = e.isIntersecting;
          aggiorna();
        },
        { rootMargin: '0px 0px 120px 0px' },
      ).observe(footer);
    }
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (Math.abs(y - ultimo) > 6) {
          giù = y > ultimo;
          ultimo = y;
          aggiorna();
        }
      },
      { passive: true },
    );
    aggiorna();
  }
</script>
