---
/**
 * "Il corridoio dei reparti": scroll orizzontale di card reparto.
 * ≥ 1024px: pin + traslazione x del binario (scripts/motion/corridoio.ts).
 * < 1024px, senza JS o con animazioni off: riga nativa con overflow-x e scroll-snap.
 */
import { Icon } from 'astro-icon/components';
import Oggetto from '../../components/Oggetto.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { reparti, prodotti, SFONDI_REPARTO } from '../../data/catalogo';
import { Picture } from 'astro:assets';

const elenco = await reparti();
const tutti = await prodotti();
const conteggio = (id: string) => tutti.filter((p) => p.data.reparto.id === id).length;
const tinte = ['rosso', 'giallo', 'azzurro', 'verde'];
---

<section
  class="corridoio relative py-20 md:py-28"
  aria-labelledby="corridoio-titolo"
  data-corridoio
>
  <div class="corridoio__palco relative" data-corridoio-palco>
    <div class="contenitore flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        occhiello="I reparti"
        titolo="Fatti un giro tra gli scaffali."
        id="corridoio-titolo"
        class="!mb-0"
      >
        Dalla cucina alla ferramenta, tutto in un posto solo. Entra nel reparto che ti serve.
      </SectionHeading>
      <div class="solo-js flex items-center gap-2" data-corridoio-frecce>
        <button
          type="button"
          class="tocco grid size-12 place-items-center rounded-full border-2 border-inchiostro"
          data-freccia="-1"
        >
          <Icon name="lucide:arrow-left" class="icona size-5" aria-hidden="true" />
          <span class="visualmente-nascosto">Reparto precedente</span>
        </button>
        <button
          type="button"
          class="tocco grid size-12 place-items-center rounded-full border-2 border-inchiostro"
          data-freccia="1"
        >
          <Icon name="lucide:arrow-right" class="icona size-5" aria-hidden="true" />
          <span class="visualmente-nascosto">Reparto successivo</span>
        </button>
      </div>
    </div>

    <div class="corridoio__finestra mt-10 md:mt-14" data-corridoio-finestra data-lenis-prevent>
      <ul class="corridoio__binario" data-binario>
        {elenco.map((r, i) => {
          const stile = SFONDI_REPARTO[r.data.colore];
          return (
            <li class="corridoio__card" data-card>
              <a
                href={`/reparti/${r.id}`}
                class="corridoio__link group block rounded-[var(--radius-card)]"
                data-cursor="Entra"
              >
                <div
                  class:list={['corridoio__visual card relative overflow-hidden', stile.bg]}
                  data-visual
                >
                  {r.data.immagine ? (
                    <Picture
                      src={r.data.immagine}
                      alt=""
                      formats={['avif', 'webp']}
                      widths={[480, 800, 1200]}
                      sizes="(min-width:1024px) 34vw, 85vw"
                      class="absolute inset-0 size-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <>
                      <svg
                        class:list={[
                          'corridoio__numero',
                          stile.scuro ? 'text-carta/25' : 'text-inchiostro/15',
                        ]}
                        viewBox="0 0 220 130"
                        aria-hidden="true"
                        data-numero
                      >
                        <text x="216" y="112" text-anchor="end">
                          {String(i + 1).padStart(2, '0')}
                        </text>
                      </svg>
                      <div class="corridoio__oggetti" aria-hidden="true" data-parallasse>
                        {r.data.oggetti.slice(0, 3).map((o, k) => (
                          <div class:list={['corridoio__oggetto', `corridoio__oggetto--${k}`]}>
                            <Oggetto
                              nome={o}
                              colore={tinte[(i + k) % tinte.length]}
                              dimensione={220}
                            />
                          </div>
                        ))}
                      </div>
                    </>
                  )}
                  <span
                    class="corridoio__cartellino cartellino absolute bottom-5 left-5 text-base"
                    data-cartellino
                  >
                    {conteggio(r.id)} articoli
                  </span>
                </div>
                <div class="mt-5 flex items-start justify-between gap-4">
                  <div>
                    <h3 class="titolo-3">{r.data.titolo}</h3>
                    <p class="mt-2 max-w-[40ch] text-grafite">{r.data.descrizione}</p>
                  </div>
                  <span
                    class="corridoio__entra grid size-12 shrink-0 place-items-center rounded-full bg-inchiostro text-carta transition-transform duration-500 group-hover:-rotate-45"
                    aria-hidden="true"
                  >
                    <Icon name="lucide:arrow-right" class="icona size-5" />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="contenitore mt-8 flex items-center gap-4">
      <div
        class="corridoio__avanzamento hidden h-1 flex-1 overflow-hidden rounded-full bg-argilla lg:block"
        aria-hidden="true"
      >
        <div class="h-full origin-left scale-x-0 rounded-full bg-pomodoro" data-avanzamento></div>
      </div>
      <div
        class="corridoio__puntini flex flex-wrap gap-2 lg:hidden"
        aria-hidden="true"
        data-puntini
      >
        {elenco.map((_, i) => (
          <span
            class:list={[
              'corridoio__puntino size-2.5 rounded-full bg-inchiostro/25',
              i === 0 && 'is-attivo',
            ]}
          />
        ))}
      </div>
      <a href="/reparti" class="link-anim ml-auto font-semibold">
        Tutti i reparti
      </a>
    </div>
  </div>
</section>

<style>
  /* Riga nativa (default) */
  .corridoio__finestra {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1rem, 4vw, 4rem);
    scrollbar-width: none;
  }
  .corridoio__finestra::-webkit-scrollbar {
    display: none;
  }
  .corridoio__binario {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding-inline: clamp(1rem, 4vw, 4rem);
  }
  .corridoio__card {
    width: min(85vw, 30rem);
    flex: none;
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .corridoio__card {
      width: min(55vw, 30rem);
    }
    .corridoio__binario {
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .corridoio__card {
      width: clamp(22rem, 32vw, 34rem);
    }
  }
  .corridoio__visual {
    aspect-ratio: 4 / 5;
  }
  /* Numero decorativo in SVG (aria-hidden): non è testo da leggere. */
  .corridoio__numero {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    width: clamp(8rem, 15vw, 14rem);
    height: auto;
    overflow: visible;
  }
  .corridoio__numero text {
    fill: currentColor;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 150px;
    letter-spacing: -0.06em;
  }
  .corridoio__oggetti {
    position: absolute;
    inset: 18% 8% 16%;
  }
  .corridoio__oggetto {
    position: absolute;
    transition: transform 0.7s var(--ease-casa);
  }
  .corridoio__oggetto--0 {
    width: 56%;
    left: 4%;
    bottom: 0;
  }
  .corridoio__oggetto--1 {
    width: 40%;
    right: 2%;
    top: 6%;
    transform: rotate(10deg);
  }
  .corridoio__oggetto--2 {
    width: 34%;
    right: 10%;
    bottom: 2%;
    transform: rotate(-8deg);
  }
  @media (hover: hover) {
    .corridoio__link:hover .corridoio__oggetto--0 {
      transform: rotate(-8deg) translateY(-6%);
    }
    .corridoio__link:hover .corridoio__oggetto--1 {
      transform: rotate(18deg) translateY(-8%);
    }
    .corridoio__link:hover .corridoio__oggetto--2 {
      transform: rotate(-14deg) translateY(-5%);
    }
    .corridoio__link:hover .corridoio__cartellino {
      animation: oscilla 0.9s var(--ease-casa);
    }
  }
  @keyframes oscilla {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    30% {
      transform: rotate(5deg);
    }
    60% {
      transform: rotate(-6deg);
    }
    80% {
      transform: rotate(-1deg);
    }
  }
  .corridoio__puntino.is-attivo {
    background: var(--color-pomodoro);
    transform: scale(1.3);
  }

  /* Versione con pin (classe aggiunta da corridoio.ts, ≥ 1024px) */
  :global(.corridoio--pin) .corridoio__finestra {
    overflow: visible;
    scroll-snap-type: none;
  }
  :global(.corridoio--pin) .corridoio__palco {
    overflow: clip;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
  }
  :global(.corridoio--pin).corridoio {
    padding-block: 0;
  }
  :global(.corridoio--pin) .corridoio__visual {
    aspect-ratio: auto;
    height: min(46svh, 36vw);
  }
</style>

<script>
  import { registra } from '../../scripts/motion/setup';
  import { collegaCorridoioNativo } from '../../scripts/corridoio-nativo';
  collegaCorridoioNativo();
  registra({
    nome: 'corridoio',
    carica: () => import('../../scripts/motion/corridoio'),
    quando: 'vicino',
    el: '[data-corridoio]',
    pin: true,
  });
</script>
