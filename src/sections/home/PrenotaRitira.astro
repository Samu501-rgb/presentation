---
/**
 * "Prenota e ritira": 3 passi (Scegli → Scrivici → Ritira) con numeri grandi,
 * linea tratteggiata tipo scontrino e mockup della chat WhatsApp.
 * Animazioni in scripts/motion/prenota.ts.
 */
import SectionHeading from '../../components/SectionHeading.astro';
import MagneticButton from '../../components/MagneticButton.astro';
import { linkWhatsApp } from '../../data/negozio';

const passi = [
  {
    n: '1',
    titolo: 'Scegli',
    testo: 'Guarda i reparti e trova quello che ti serve. Quello che vedi c’è.',
  },
  {
    n: '2',
    titolo: 'Scrivici',
    testo: 'Mandaci un messaggio su WhatsApp con il nome dell’articolo.',
  },
  { n: '3', titolo: 'Ritira', testo: 'Passa in negozio quando vuoi: lo trovi messo da parte.' },
];
---

<section
  class="prenota contenitore cv-auto py-24 md:py-36"
  aria-labelledby="prenota-titolo"
  data-prenota
>
  <div class="griglia items-center gap-y-16">
    <div class="col-span-4 md:col-span-7">
      <SectionHeading occhiello="Prenota e ritira" titolo="Lo vedi, ce l’hai." id="prenota-titolo">
        Mandaci un messaggio, te lo mettiamo da parte. Nessun carrello, nessun account: passi e
        ritiri.
      </SectionHeading>

      <div class="prenota__passi relative">
        <svg
          class="prenota__linea prenota__linea--orizzontale absolute left-[2.6rem] right-[2.6rem] top-[2.6rem] hidden h-1 md:block"
          viewBox="0 0 100 2"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M0 1H100"
            pathLength="1"
            fill="none"
            stroke="#1F1A17"
            stroke-width="2"
            stroke-dasharray="0.012 0.012"
            vector-effect="non-scaling-stroke"
            data-linea
          ></path>
        </svg>
        <svg
          class="prenota__linea absolute bottom-10 left-[2.6rem] top-10 w-1 md:hidden"
          viewBox="0 0 2 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M1 0V100"
            pathLength="1"
            fill="none"
            stroke="#1F1A17"
            stroke-width="2"
            stroke-dasharray="0.02 0.02"
            vector-effect="non-scaling-stroke"
            data-linea
          ></path>
        </svg>
        <ol class="relative grid gap-10 md:grid-cols-3 md:gap-6">
          {passi.map((p) => (
            <li class="prenota__passo flex gap-5 md:block" data-passo>
              <span
                class="prenota__numero tabular grid size-[5.2rem] shrink-0 place-items-center rounded-full bg-limone font-display text-5xl font-extrabold ring-2 ring-inchiostro"
                aria-hidden="true"
                data-numero={p.n}
              >
                {p.n}
              </span>
              <div class="md:mt-6">
                <h3 class="titolo-3">
                  <span class="visualmente-nascosto">Passo {p.n}: </span>
                  {p.titolo}
                </h3>
                <p class="mt-2 max-w-[30ch] text-grafite">{p.testo}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-12">
        <MagneticButton
          href={linkWhatsApp()}
          testo="Scrivici su WhatsApp"
          variante="pomodoro"
          icona="lucide:message-circle"
          esterno
        />
      </div>
    </div>

    <!-- Mockup del telefono: conversazione di esempio -->
    <figure class="col-span-4 md:col-span-5 md:col-start-8" data-telefono>
      <div class="prenota__telefono mx-auto w-full max-w-[22rem] rounded-[2.75rem] bg-inchiostro p-3 shadow-[0_30px_60px_-30px_rgb(31_26_23/0.6)]">
        <div class="overflow-hidden rounded-[2.2rem] bg-[#EFE7DA]">
          <div class="flex items-center gap-3 bg-bonifica px-5 py-4 text-carta">
            <span
              class="grid size-10 place-items-center rounded-full bg-limone font-display text-lg font-extrabold text-inchiostro"
              aria-hidden="true"
            >
              G
            </span>
            <div class="leading-tight">
              <p class="font-semibold">Gino Casa</p>
              <p class="text-sm text-carta/80" data-sta-scrivendo-testata>
                online
              </p>
            </div>
          </div>
          <ol
            class="flex min-h-[22rem] flex-col gap-3 p-4 text-[0.95rem]"
            aria-label="Esempio di conversazione su WhatsApp"
          >
            <li class="prenota__bolla prenota__bolla--io" data-bolla>
              Ciao Gino Casa! Vorrei prenotare: Moka 3 tazze. Passo a ritirarla domani pomeriggio.
              Grazie!
            </li>
            <li class="prenota__bolla prenota__bolla--scrive" aria-hidden="true" data-scrive>
              <span></span>
              <span></span>
              <span></span>
            </li>
            <li class="prenota__bolla prenota__bolla--loro" data-bolla>
              Ciao! Te la mettiamo da parte. A domani!
            </li>
            <li class="prenota__bolla prenota__bolla--io" data-bolla>
              Perfetto, grazie!
            </li>
          </ol>
        </div>
      </div>
      <figcaption class="mt-4 text-center text-sm text-grafite">
        Esempio di conversazione.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .prenota__bolla {
    max-width: 82%;
    padding: 0.6rem 0.85rem;
    border-radius: 1rem;
    line-height: 1.35;
    box-shadow: 0 1px 0 rgb(31 26 23 / 0.12);
  }
  .prenota__bolla--io {
    align-self: flex-end;
    background: #d4efc4;
    border-bottom-right-radius: 0.3rem;
  }
  .prenota__bolla--loro {
    align-self: flex-start;
    background: #ffffff;
    border-bottom-left-radius: 0.3rem;
  }
  .prenota__bolla--scrive {
    display: none;
    align-self: flex-start;
    background: #ffffff;
    gap: 4px;
  }
  .prenota__bolla--scrive span {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-grafite);
    animation: punto 1s infinite ease-in-out;
  }
  .prenota__bolla--scrive span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .prenota__bolla--scrive span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes punto {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
</style>

<script>
  import { registra } from '../../scripts/motion/setup';
  registra({
    nome: 'prenota',
    carica: () => import('../../scripts/motion/prenota'),
    quando: 'vicino',
    el: '[data-prenota]',
  });
</script>
