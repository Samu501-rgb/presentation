---
/**
 * Manifesto: frase grande che si "accende" parola per parola scorrendo.
 * Le parole sono già divise nel markup (nessun layout shift, testo leggibile
 * anche senza JS). Versione CSS con animation-timeline dove supportata,
 * fallback GSAP in scripts/motion/manifesto.ts.
 */
interface Props {
  frase?: string;
  chiave?: string;
  livello?: 'h2' | 'p';
}
const {
  frase = 'Ti serviva una cosa sola. Ne hai trovate dieci. Succede, da Gino Casa.',
  chiave = 'dieci.',
  livello = 'h2',
} = Astro.props;
const parole = frase.split(' ');
const Tag = livello;
---

<section class="manifesto contenitore py-24 md:py-40" aria-label="Manifesto" data-manifesto>
  <p class="occhiello mb-8 flex items-center gap-2">
    <span class="inline-block size-2.5 rounded-full bg-pomodoro" aria-hidden="true"></span>Da Gino
    Casa
  </p>
  <Tag class="manifesto__frase titolo-2 max-w-[18ch] !text-[clamp(2.5rem,7.5vw,7rem)]">
    {parole.map((p, i) => (
      <>
        <span
          class:list={['parola', p === chiave && 'parola--chiave']}
          style={`--p:${(i / (parole.length - 1)).toFixed(3)}`}
        >
          {p}
        </span>
        {i < parole.length - 1 && ' '}
      </>
    ))}
  </Tag>
</section>

<style>
  .parola {
    display: inline-block;
  }
  .parola--chiave {
    position: relative;
    z-index: 0;
    padding-inline: 0.1em;
  }
  .parola--chiave::before {
    content: '';
    position: absolute;
    inset: 0.08em -0.04em 0.02em;
    z-index: -1;
    border-radius: 0.2em;
    background: var(--color-limone);
    transform: rotate(-3deg);
    box-shadow: 0 3px 0 rgb(31 26 23 / 0.2);
  }
  @supports (animation-timeline: view()) {
    :global(html[data-motion='full']) .manifesto {
      view-timeline-name: --manifesto;
    }
    :global(html[data-motion='full']) .parola {
      animation: accendi linear both;
      animation-timeline: --manifesto;
      animation-range: cover calc(18% + var(--p) * 38%) cover calc(26% + var(--p) * 38%);
    }
    :global(html[data-motion='full']) .parola--chiave::before {
      animation: adesivo linear both;
      animation-timeline: --manifesto;
      animation-range: cover 50% cover 58%;
    }
  }
  @keyframes adesivo {
    from {
      transform: rotate(-8deg) scale(0);
    }
    to {
      transform: rotate(-3deg) scale(1);
    }
  }
</style>

<script>
  import { registra } from '../../scripts/motion/setup';
  registra({
    nome: 'manifesto',
    carica: () => import('../../scripts/motion/manifesto'),
    quando: 'vicino',
    el: '[data-manifesto]',
  });
</script>
